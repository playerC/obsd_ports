+  endOffset = convertToUTF8Offset(Contents,endLineIndex, End.character, lspEncoding(), valid);
+  if (!valid){
+        return error(llvm::errc::invalid_argument,
+		     "End.character:[{0}] is invalid.",
+		     End.character
+		 );
+  }
+
+   Contents.replace(startOffset, endOffset - startOffset, Change.text);
+
+  return llvm::Error::success();
+}
